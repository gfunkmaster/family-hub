# Postgres. Lokalt: docker run -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:17
DATABASE_URL=postgresql://postgres:dev@localhost:5432/familyhub
# Lösenordet familjen loggar in med
FAMILY_PASSWORD=byt-mig
# Minst 32 tecken slumpmässigt, signerar inloggningskakan: openssl rand -hex 32
SESSION_SECRET=
# Token som den schemalagda körningen skickar som Bearer: openssl rand -hex 32
AGENT_TOKEN=
# Direktsökning via Claude API (valfritt). Utan nyckel tas beställningar bara av torsdagskörningen.
ANTHROPIC_API_KEY=
# Modell och budgettak i USD. Sökningen startar bara om månadens kostnad + AGENT_MAX_RUN_USD ryms i budgeten.
AGENT_MODEL=claude-sonnet-5-5
AGENT_MONTHLY_BUDGET_USD=10
AGENT_MAX_RUN_USD=1
