// Familjeaktiviteter. En familj per installation; tabellerna speglar artifactens databas
// (se docs/datamodell.md) så att data kan flyttas över rakt av.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Familjeprofilen. Alltid id 1. `data` följer typen Profile i @family-hub/logic.
model Profile {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

/// En stad med transport, restidsgräns och källregister. `data` följer typen City.
model City {
  id        String   @id
  name      String
  data      Json
  updatedAt DateTime @updatedAt
  runs      Run[]
  requests  Request[]
}

/// En körning: förslag för en period i en stad eller runt en plats. `items` är Item[],
/// `food` är FoodSpot[] (mat nära aktiviteterna) och `packed` PackedFood[] (matlådor).
model Run {
  id        String   @id
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])
  place     Json?
  from      String
  to        String
  kind      String
  dates     String[]
  origin    Json?
  summary   String   @default("")
  weather   Json
  items     Json
  food      Json     @default("[]")
  packed    Json     @default("[]")
  /// Sidor som agenten hämtade, från verktygssvaren: [{url, ok, error?}]. Tom för körningar utan logg.
  fetched   Json     @default("[]")
  createdAt DateTime
  updatedAt DateTime @updatedAt
  schedule  SavedSchedule?

  @@index([cityId, createdAt])
}

/// Familjens sparade schema för en körning: [{date, itemIds}] med upp till fyra förslag per dag.
/// Ett per körning. En dag med tom lista är en vald vilodag.
model SavedSchedule {
  runId     String   @id
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  days      Json
  updatedAt DateTime @updatedAt
}

/// En beställning. `mode` är "direkt" (sidan söker via Claude API) eller "kö" (torsdagskörningen).
/// Antingen en sparad stad eller en plats ({name, address?, lat?, lng?}) med radie.
model Request {
  id        String   @id @default(cuid())
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])
  place     Json?
  radiusKm  Int?
  mode      String   @default("kö")
  error     String?
  from      String
  to        String
  kind      String
  origin    Json?
  note      String   @default("")
  status    String   @default("ny")
  runId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Betyg på ett förslag. Nyckeln är `<stad>--<förslag>` som i artifacten.
model Rating {
  key     String   @id
  cityId  String
  itemId  String
  title   String
  tags    String[]
  verdict String
  stars   Int?
  runId   String?
  ratedAt DateTime @default(now())
}

/// Kostnad för varje direktsökning, för budgettaket.
model AgentUsage {
  id               String   @id @default(cuid())
  requestId        String?
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  webSearches      Int      @default(0)
  webFetches       Int      @default(0)
  costUsd          Float
  createdAt        DateTime @default(now())

  @@index([createdAt])
}
