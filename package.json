{
  "name": "familjeaktiviteter",
  "version": "0.6.0",
  "private": true,
  "description": "Agent och app som hittar aktiviteter för barnfamiljer: helg, vecka eller månad, efter barnens ålder, restid och budget.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.mjs\"",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "web:dev": "npm run dev -w @family-hub/web",
    "web:build": "npm run build -w @family-hub/web",
    "web:test": "npm test -w @family-hub/web",
    "web:typecheck": "npm run typecheck -w @family-hub/web",
    "web:lint": "npm run lint -w @family-hub/web"
  },
  "devDependencies": {
    "eslint": "10.1.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*",
    "web"
  ]
}
